{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(cd:*)",
      "Write(**)",
      "Edit(**)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime --memories-only",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --memories-only",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}